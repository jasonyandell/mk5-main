{
  "name": "@jasonyandell/walt",
  "version": "0.1.0",
  "description": "Walt, a Texas 42 player that never sees another seat's hand: a fair, fast computer partner or opponent for a 42 game. WebAssembly, for browsers, Web Workers and Node. Public domain.",
  "license": "CC0-1.0",
  "author": "Jason Yandell",
  "homepage": "https://github.com/jasonyandell/mk5-main/tree/main/walt1#readme",
  "bugs": "https://github.com/jasonyandell/mk5-main/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonyandell/mk5-main.git",
    "directory": "walt1"
  },
  "keywords": [
    "texas-42",
    "42",
    "dominoes",
    "domino",
    "game-ai",
    "imperfect-information",
    "webassembly",
    "wasm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./walt_bg.wasm": "./pkg/walt_bg.wasm",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "pkg/walt.js",
    "pkg/walt.d.ts",
    "pkg/walt_bg.wasm",
    "pkg/walt_bg.wasm.d.ts",
    "WALT.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "pretest": "./scripts/build.sh",
    "test": "node --test 'tests/*.test.js'",
    "bench": "node scripts/bench.js",
    "prepack": "./scripts/build.sh"
  }
}
