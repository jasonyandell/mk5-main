    "useful_failure_run": "https://wandb.ai/jasonyandell-forge42/w42/runs/oizyjty5"
  },
  "recommended_view": {
    "name": "w42 run comparison",
    "entity": "jasonyandell-forge42",
    "project": "w42",
    "filters": [
      {
        "field": "tags",
        "operator": "contains",
        "value": "w42"
      }
    ],
    "group_by": [
      "group",
      "config.bead_id"
    ],
    "sort": [
      {
        "field": "created_at",
        "direction": "asc"
      }
    ],
    "include_states": [
      "finished",
      "failed",
      "crashed"
    ],
    "columns": [
      "name",
      "id",
      "state",
      "group",
      "tags",
      "config.bead_id",
      "config.git_sha",
      "summary.status",
      "summary.best_mean_regret",
      "summary.best_match_rate",
      "summary.best_tail_regret_rate_ge_5",
      "summary.ruleset_supported",
      "summary.ruleset_checks/failed",
      "summary.failure/type",
      "summary.failure/message",
      "created_at",
      "url"
    ],
    "panels": [
      {
        "title": "Model comparison: best mean regret",
        "type": "line_or_bar",
        "x": "config.bead_id",
        "y": "summary.best_mean_regret",
        "runs": [
          "wv7pkuco",
          "3xyy2dxr",
          "c5x85xfx"
        ]
      },
      {
        "title": "Model comparison: match rate",
        "type": "line_or_bar",
        "x": "config.bead_id",
        "y": "summary.best_match_rate",
        "runs": [
          "3xyy2dxr",
          "c5x85xfx"
        ]
      },
      {
        "title": "Failures and superseded runs",
        "type": "table",
        "filters": [
          "state != finished OR tags contains diagnostic OR run_id in [c5x85xfx,w4wupdih]"
        ],
        "columns": [
          "name",
          "state",
          "summary.status",
          "summary.failure/type",
          "summary.failure/message",
          "url"
        ]
      },
      {
        "title": "Claim validation runs",
        "type": "table",
        "filters": [
          "tags contains strategy-validation"
        ],
        "columns": [
          "config.bead_id",
          "name",
          "group",
          "summary.status",
          "summary.ruleset_supported",
          "summary.ruleset_checks/failed",
          "url"
        ]
      }
    ]
  },
