{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk5.local/schemas/w42-claim-ledger.schema.json",
  "title": "w42 Claim Ledger",
  "description": "Conservative claim-ledger schema for Winning 42 strategy-validation claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_impact", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "ledger_impact": {
      "type": "string",
      "description": "Short impact statement for the artifact or report that updated the ledger."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_entry"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "contradicted",
        "context-limited",
        "underpowered",
        "not-yet-tested"
      ]
    },
    "readiness": {
      "type": "string",
      "enum": [
        "enumeration",
        "oracle",
        "gus",
        "w42",
        "burl",
        "ruleset",
        "trace-audit",
        "report-only"
      ]
    },
    "string_or_na": {
      "type": "string",
      "minLength": 1
    },
    "chapter_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wiki_page"],
      "properties": {
        "wiki_page": {
          "type": "string",
          "pattern": "^wiki/experiments/winning42-.*\\.md$"
        },
        "source_slice": {
          "$ref": "#/$defs/string_or_na"
        },
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "source_note": {
          "$ref": "#/$defs/string_or_na"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "configs",
        "data_inputs",
        "commit_sha",
        "random_seeds",
        "wandb_links",
        "hf_links"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configs": {
          "$ref": "#/$defs/string_or_na"
        },
        "data_inputs": {
          "$ref": "#/$defs/string_or_na"
        },
        "commit_sha": {
          "$ref": "#/$defs/string_or_na"
        },
        "random_seeds": {
          "$ref": "#/$defs/string_or_na"
        },
        "wandb_links": {
          "$ref": "#/$defs/string_or_na"
        },
        "hf_links": {
          "$ref": "#/$defs/string_or_na"
        }
      }
    },
    "claim_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "chapter_source",
        "claim",
        "detector",
        "metric_test",
        "data_source",
        "readiness",
        "evidence_artifact",
        "status",
        "caveats",
        "provenance"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "chapter_source": {
          "$ref": "#/$defs/chapter_source"
        },
        "claim": {
          "$ref": "#/$defs/string_or_na"
        },
        "detector": {
          "$ref": "#/$defs/string_or_na"
        },
        "metric_test": {
          "$ref": "#/$defs/string_or_na"
        },
        "data_source": {
          "$ref": "#/$defs/string_or_na"
        },
        "readiness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/readiness"
          }
        },
        "evidence_artifact": {
          "$ref": "#/$defs/string_or_na"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "caveats": {
          "$ref": "#/$defs/string_or_na"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
