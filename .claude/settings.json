{
  "enabledPlugins": {},
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/file-check.sh",
            "type": "command"
          }
        ],
        "matcher": "(Write|Edit|MultiEdit|NotebookEdit).*\\.(ts|svelte)$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  }
}