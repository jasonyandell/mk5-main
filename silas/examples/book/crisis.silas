    (viewer b)
    (bidder b)
    (on-lead b)
    (crisis)
    (own-legal 6-5)
    (own-legal 6-4)
    (not (trump-tile 6-5))
    (not (trump-tile 6-4)))
  (rule cash-a-double-that-is-count (play dd)
    (viewer b)
    (bidder b)
    (on-lead b)
    (crisis)
    (own-legal dd)
    (double dd)
    (not (trump-tile dd))
    (count-tile dd))
  (rule a-count-double-away-from-his-suit (play dd)
    (viewer b)
    (bidder b)
    (on-lead b)
    (crisis)
    (own-legal dd)
    (double dd)
    (not (trump-tile dd))
    (calls-for-count dd)
    (leads-context dd s)
    (none (roles h l his)
      (setter h)
      (not (shown-out-of-trump h))
      (played-to l h his)
      (not (tile his l))
      (in his s))
    ; GAP aggregate: and no such double has more of its suit still out
  )
  (rule a-count-double (play dd)
    (viewer b)
    (bidder b)
    (on-lead b)
    (crisis)
    (own-legal dd)
    (double dd)
    (not (trump-tile dd))
