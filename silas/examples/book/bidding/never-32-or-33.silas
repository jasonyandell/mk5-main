; Never 32 or 33. Winning 42 (S-0152-c, S-0153-b; cluster A of
; docs/cross-game.md): bid only enough, except that a raise to 32 or 33 goes
; past them, to 34, when the hand is worth 34, and is a pass otherwise. Its
; worth is bid-only-enough's (the arena's risk budget), so where that policy
; raises to anything but 32 or 33 this one does the same; the declaration is
; the fallback's, the first suit offered.
;
; Our reading of "past them": the least level above 33, as "bid only enough"
; would say. The book's own raises go on to 35 (S-0034-a), which is the 35
; rule of risk-budget.silas, not this one.
(include bidding)

(policy never-32-or-33
  (bidding
    (rule past-33 (bid 34)
      (<= 32 (least-raise) 33)
      (some (roles t) (suit-at-least t 3) (<= (+ 34 (points (roles c) (exposed c t))) 42)))
    (rule only-enough (bid least-raise)
      (not (<= 32 (least-raise) 33))
      (some (roles t)
        (suit-at-least t 3)
        (<= (+ (least-raise) (points (roles c) (exposed c t))) 42)))))
