; C22  Winning 42 pp. 50-51 (W42-p051-a, W42-p051-b)
; Rule, in our words: in a trump set (the bidder led trump, this opponent
; followed and his partner did not), the opponent holding the trumps, void in
; the suit of the bidder's double, trumps it from the seat just after the
; bidder, since count may still fall on the trick; from the last seat he
; trumps only if count is already on it.
; Python gate (pour_setter gate_c22): a setter at either seat, the bidder led a
; non-trump double, the mover is void in its suit and holds two or more trumps;
; the book's tiles are his trumps.
; How this encoding differs: it is the book's rule, narrower than the gate. It
; has the trump-set trigger, which the gate does not; from the last seat it
; fires only on count already played, where the gate fires on any trick.
; "Holds two or more trumps" is the gate's reading of the book's trump-rich
; opponent.
; Void in the led suit is read from the hand: a legal trump on a non-trump lead.
; Count on the trick is the double's own, or a tile played by the bidder's
; partner (c, distinct from the other chairs) or by my partner (c the same as
; pard): roles declared together are distinct unless `same` joins them.
(policy c22-trump-the-double-from-the-left
  (fallback lowest-legal)
  (rule trump-in (select answer)
    (guard
      (query
        (roles
          (chair b) (chair me) (chair pard)
          (domino set) (domino mine) (domino his)
          (domino doubled) (domino ruff) (domino other) (context led))
        (out ruff)
        (pattern
          (viewer me)
          (declarer b)
          (successor b me)
          (partner me pard)
          (led b set)
          (in set q*)
          (played-to set me mine)
          (in mine q*)
          (played-to set pard his)
          (not (in his q*))
          (leader b)
          (trick-play b doubled)
          (double doubled)
          (not (in doubled q*))
          (led-context led)
          (own-legal ruff)
          (in ruff q*)
          (own-legal other)
          (in other q*)))))
  (rule trump-in-on-count (select answer)
    (guard
      (query
        (roles
          (chair b) (chair me) (chair pard) (chair c)
          (domino set) (domino mine) (domino his)
          (domino doubled) (domino on) (domino ruff) (domino other) (context led))
        (out ruff)
        (pattern
          (viewer me)
          (declarer b)
          (successor me b)
          (partner me pard)
          (led b set)
          (in set q*)
          (played-to set me mine)
          (in mine q*)
          (played-to set pard his)
          (not (in his q*))
          (leader b)
          (trick-play b doubled)
          (double doubled)
          (not (in doubled q*))
          (led-context led)
          (trick-play c on)
          (not (count on 0))
          (own-legal ruff)
          (in ruff q*)
          (own-legal other)
          (in other q*))
        (pattern
          (same c pard)
          (viewer me)
          (declarer b)
          (successor me b)
          (partner me pard)
          (led b set)
          (in set q*)
          (played-to set me mine)
          (in mine q*)
          (played-to set pard his)
          (not (in his q*))
          (leader b)
          (trick-play b doubled)
          (double doubled)
          (not (in doubled q*))
          (led-context led)
          (trick-play c on)
          (not (count on 0))
          (own-legal ruff)
          (in ruff q*)
          (own-legal other)
          (in other q*))
        (pattern
          (viewer me)
          (declarer b)
          (successor me b)
          (partner me pard)
          (led b set)
          (in set q*)
          (played-to set me mine)
          (in mine q*)
          (played-to set pard his)
          (not (in his q*))
          (leader b)
          (trick-play b doubled)
          (double doubled)
          (not (in doubled q*))
          (not (count doubled 0))
          (led-context led)
          (own-legal ruff)
          (in ruff q*)
          (own-legal other)
          (in other q*))))))
