; C1b-nontop and C1b-top  Winning 42 pp. 37-38 (W42-p037-h, W42-p038-c,
; W42-p038-d; played in Hands 31 and 32, pp. 106, 109)
; Rule, in our words: the bidder's partner, out of trump, follows the bidder's
; trump lead. If the lead is the highest trump still unplayed, the trick is
; safe: give count, the biggest first. If a live trump can still beat the lead,
; the trick is not safe: give no count.
; Python gate (pour_bidder gate_c1b): the same two branches, when the partner
; holds count. The two gate ids are one rule with two branches, so they share
; this file.
; How this encoding differs: none from the gate.
; Out of trump is read from the hand: following a trump lead, a legal tile that
; is not trump proves the viewer holds no trump.
(policy c01b-partner-count-on-a-trump-lead
  (initial play)
  (fallback lowest-legal)
  (rule not-top-lead-no-count (in play) (next play) (select answer)
    (guard
      (query
        (roles (chair b) (chair p) (domino give) (domino led) (domino over) (domino held))
        (out give)
        (pattern
          (viewer p)
          (declarer b)
          (partner b p)
          (leader b)
          (led-context q*)
          (trick-play b led)
          (live over)
          (beats over led q*)
          (own-legal give)
          (not (in give q*))
          (count give 0)
          (own-legal held)
          (not (count held 0))))))
  (rule top-lead-give-ten (in play) (next play) (select answer)
    (guard
      (query
        (roles (chair b) (chair p) (domino give) (domino led))
        (out give)
        (pattern
          (viewer p)
          (declarer b)
          (partner b p)
          (leader b)
          (led-context q*)
          (trick-play b led)
          (none (roles (domino over)) (live over) (beats over led q*))
          (own-legal give)
          (not (in give q*))
          (count give 10)))))
  (rule top-lead-give-five (in play) (next play) (select answer)
    (guard
      (query
        (roles (chair b) (chair p) (domino give) (domino led))
        (out give)
        (pattern
          (viewer p)
          (declarer b)
          (partner b p)
          (leader b)
          (led-context q*)
          (trick-play b led)
          (none (roles (domino over)) (live over) (beats over led q*))
          (own-legal give)
          (not (in give q*))
          (count give 5))))))
