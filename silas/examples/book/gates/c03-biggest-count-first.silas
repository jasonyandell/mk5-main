; C3  Winning 42 p. 37 (W42-p037-h) and p. 106 (W42-p106-c, Hand 31)
; Rule, in our words: when the bidder's partner gives count on a trick the
; bidder is taking, he gives his biggest count tile first, a ten before a five.
; Python gate (pour_bidder gate_c3): partner, cannot follow, bidder currently
; winning, holding two or more count tiles; the book's tiles are the largest.
; How this encoding differs: none. "Largest" is rule order (tens, then fives);
; "two or more" is two distinct roles.
; The book states the rule for a trick the partner knows is safe (C1); the gate,
; and this encoding, read "the bidder is winning so far", which is weaker.

(include book)

(policy c03-biggest-count-first
  (fallback lowest-legal)
  (rule give-a-ten
    (select answer)
    (guard
      (query (roles (chair p) (domino give) (domino other))
        (out give)
        (pattern
          (viewer p)
          (bidders-partner p)
          (bidder-winning)
          (discard give)
          (count give 10)
          (own-legal other)
          (count-tile other)))))
  (rule give-a-five
    (select answer)
    (guard
      (query (roles (chair p) (domino give) (domino other))
        (out give)
        (pattern
          (viewer p)
          (bidders-partner p)
          (bidder-winning)
          (discard give)
          (count give 5)
          (own-legal other)
          (count other 5))))))
