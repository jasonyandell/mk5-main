; C9  Winning 42 pp. 39-40 (W42-p040-b, W42-p040-c, W42-p040-d); played in
; Hands 29, 30 and 31 (pp. 101, 103, 107)
; Rule, in our words: the bidder's partner on lead never leads trump. Among his
; other tiles he leads one that cannot draw count; failing that, one that can
; draw only a five; a ten-count suit last.
; Python gate (pour_bidder gate_c9): "never trump", partner on lead holding
; trump and a non-trump, the book's tiles the non-trumps; and the ordering, a
; narrower gate in the same function, when the partner holds no non-trump
; double and no walker (a non-trump no unseen tile beats in the suit it leads):
; the non-trumps whose suit has no count out, else only fives out, else any.
; How this encoding differs: none from the gate. The ordering is rule order:
; its first two rules, then "never trump". The book's own exception (every
; other lead calls a ten) is in neither.

(include book)

(policy c09-partner-never-leads-trump
  (fallback lowest-legal)
  (rule lead-from-a-count-safe-suit
    (select answer)
    (guard
      (query (roles (chair p) (domino lead))
        (out lead)
        (pattern
          (viewer p)
          (bidders-partner p)
          (on-lead p)
          (none (roles (domino held)) (own-legal held) (double held) (not (trump-tile held)))
          (none (roles (domino w)) (walker w))
          (own-legal lead)
          (not (trump-tile lead))
          (not (calls-for-count lead))))))
  (rule lead-from-a-five-suit
    (select answer)
    (guard
      (query (roles (chair p) (domino lead))
        (out lead)
        (pattern
          (viewer p)
          (bidders-partner p)
          (on-lead p)
          (none (roles (domino held)) (own-legal held) (double held) (not (trump-tile held)))
          (none (roles (domino w)) (walker w))
          (own-legal lead)
          (not (trump-tile lead))
          (not (calls-for lead 10))))))
  (rule lead-anything-but-trump
    (select answer)
    (guard
      (query (roles (chair p) (domino lead) (domino trump))
        (out lead)
        (pattern
          (viewer p)
          (bidders-partner p)
          (on-lead p)
          (own-legal lead)
          (not (trump-tile lead))
          (own-legal trump)
          (trump-tile trump))))))
