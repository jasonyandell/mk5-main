; C1b-nontop and C1b-top  Winning 42 pp. 37-38 (W42-p037-h, W42-p038-c,
; W42-p038-d; played in Hands 31 and 32, pp. 106, 109)
; Rule, in our words: the bidder's partner, out of trump, follows the bidder's
; trump lead. If the lead is the highest trump still unplayed, the trick is
; safe: give count, the biggest first. If a live trump can still beat the lead,
; the trick is not safe: give no count.
; Python gate (pour_bidder gate_c1b): the same two branches, when the partner
; holds count. The two gate ids are one rule with two branches, so they share
; this file.
; How this encoding differs: none from the gate.
; Out of trump is read from the hand: following a trump lead, a legal tile that
; is not trump proves the viewer holds no trump.

(include book)

(policy c01b-partner-count-on-a-trump-lead
  (fallback lowest-legal)
  (rule not-top-lead-no-count
    (select answer)
    (guard
      (query (roles (chair p) (domino led) (domino give) (domino held))
        (out give)
        (pattern
          (viewer p)
          (bidders-partner p)
          (trump-led)
          (bidder-led led)
          (beatable led)
          (own-legal give)
          (not (trump-tile give))
          (count give 0)
          (own-legal held)
          (count-tile held)))))
  (rule top-lead-give-ten
    (select answer)
    (guard
      (query (roles (chair p) (domino led) (domino give))
        (out give)
        (pattern
          (viewer p)
          (bidders-partner p)
          (trump-led)
          (bidder-led led)
          (not (beatable led))
          (own-legal give)
          (not (trump-tile give))
          (count give 10)))))
  (rule top-lead-give-five
    (select answer)
    (guard
      (query (roles (chair p) (domino led) (domino give))
        (out give)
        (pattern
          (viewer p)
          (bidders-partner p)
          (trump-led)
          (bidder-led led)
          (not (beatable led))
          (own-legal give)
          (not (trump-tile give))
          (count give 5))))))
