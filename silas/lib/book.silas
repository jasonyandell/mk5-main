; The book's vocabulary (Roberson, Winning 42) as named relations over one
; frame: the seats named from the bidder, the trump, the count, and what a lead
; calls for. A query or a policy brings it in with (include book); every rule in
; examples/book/ is written with it.
;
; A definition's parameters stand for whatever the caller passes; a role it
; needs of its own is declared in a (some ...) or a (none ...), distinct from
; the others declared with it and not from the roles around it.

; -- The seats, named from the bidder.

; b won the auction.
(define bidder (roles (chair b))
  (declarer b))

; p is the bidder's partner.
(define bidders-partner (roles (chair p))
  (some (roles b) (declarer b) (partner b p)))

; s is one of the two setters.
(define setter (roles (chair s))
  (some (roles b) (declarer b) (opponent b s)))

; s plays just after the bidder: the left setter.
(define left-setter (roles (chair s))
  (some (roles b) (declarer b) (successor b s)))

; s plays just before the bidder: the right setter.
(define right-setter (roles (chair s))
  (some (roles b) (declarer b) (successor s b)))

; c leads the next trick.
(define on-lead (roles (chair c))
  (leader c)
  (next-actor c))

; The bidder led the open trick (or leads the next).
(define bidders-lead (roles)
  (some (roles b) (declarer b) (leader b)))

; The bidder led d to the open trick.
(define bidder-led (roles (domino d))
  (some (roles b) (declarer b) (leader b) (trick-play b d)))

; The bidder is taking the open trick so far.
(define bidder-winning (roles)
  (some (roles b) (declarer b) (current-winner b)))

; -- The viewer's play to the open trick.

; d is a legal play that follows the suit led.
(define follower (roles (domino d))
  (own-legal d)
  (some (roles q) (led-context q) (in d q)))

; d is a legal play that does not follow the suit led: the viewer is void.
(define discard (roles (domino d))
  (own-legal d)
  (some (roles q) (led-context q) (not (in d q))))

; -- The count.

(define count-tile (roles (domino d))
  (not (count d 0)))

; A tile already on the open trick is count.
(define count-on-trick (roles)
  (some (roles c d) (trick-play c d) (count-tile d)))

; -- The trump: one context under every declaration that has one, none under
; no trump.

(define trump-tile (roles (domino d))
  (some (roles t) (trump t) (in d t)))

; The open trick was led in trump.
(define trump-led (roles)
  (some (roles t) (trump t) (led-context t)))

; c has shown void in trump.
(define shown-out-of-trump (roles (chair c))
  (some (roles t) (trump t) (shown-void c t)))

; c holds no trump, in this world.
(define void-in-trump (roles (chair c))
  (some (roles t) (trump t) (void c t)))

; A trump set: the bidder led trump, c followed it, and c's partner did not.
(define trump-set (roles (chair c))
  (some (roles b p lead his partners)
    (declarer b)
    (partner c p)
    (led b lead)
    (trump-tile lead)
    (played-to lead c his)
    (trump-tile his)
    (played-to lead p partners)
    (not (trump-tile partners))))

; The trump set as the book reads it: on a trump lead of the bidder's, c
; followed with trump and both other players (c's partner and the bidder's)
; did not. c holds the trumps.
(define trump-set-alone (roles (chair c))
  (some (roles b p q lead his theirs partners)
    (declarer b)
    (partner b p)
    (partner c q)
    (led b lead)
    (trump-tile lead)
    (played-to lead c his)
    (trump-tile his)
    (played-to lead q theirs)
    (not (trump-tile theirs))
    (played-to lead p partners)
    (not (trump-tile partners))))

; A trump outside the viewer's hand is still live.
(define trump-out (roles)
  (some (roles d) (live d) (not (mine d)) (trump-tile d)))

; c may yet trump the open trick: he has not played to it, has not shown void
; in trump, and a trump outside the viewer's hand is still live.
(define may-yet-trump (roles (chair c))
  (none (roles y) (trick-play c y))
  (not (shown-out-of-trump c))
  (trump-out))

; d is the top trump: no trump beats it, played or not.
(define top-trump (roles (domino d))
  (some (roles t) (trump t) (in d t) (none (roles e) (in e t) (beats e d t))))

; d is the trump next below `above`, played or not.
(define next-trump (roles (domino above) (domino d))
  (some (roles t)
    (trump t)
    (in above t)
    (in d t)
    (beats above d t)
    (none (roles e) (in e t) (beats above e t) (beats e d t))))

; d is the highest trump still live.
(define boss-trump (roles (domino d))
  (some (roles t) (trump t) (boss d t)))

; d is the viewer's lowest trump.
(define lowest-trump-held (roles (domino d))
  (some (roles t) (trump t) (mine d) (in d t) (none (roles e) (mine e) (in e t) (beats d e t))))

; The viewer holds four trumps or more.
(define four-trumps-or-more (roles)
  (some (roles a b c d)
    (mine a)
    (trump-tile a)
    (mine b)
    (trump-tile b)
    (mine c)
    (trump-tile c)
    (mine d)
    (trump-tile d)))

; The viewer holds exactly four trumps.
(define exactly-four-trumps (roles)
  (some (roles a b c d)
    (mine a)
    (trump-tile a)
    (mine b)
    (trump-tile b)
    (mine c)
    (trump-tile c)
    (mine d)
    (trump-tile d)
    (none (roles e)
      (mine e)
      (trump-tile e)
      (not (tile e a))
      (not (tile e b))
      (not (tile e c))
      (not (tile e d)))))

; The viewer holds exactly three trumps.
(define exactly-three-trumps (roles)
  (some (roles a b c)
    (mine a)
    (trump-tile a)
    (mine b)
    (trump-tile b)
    (mine c)
    (trump-tile c)
    (none (roles e) (mine e) (trump-tile e) (not (tile e a)) (not (tile e b)) (not (tile e c)))))

; The viewer holds exactly two trumps.
(define exactly-two-trumps (roles)
  (some (roles a b)
    (mine a)
    (trump-tile a)
    (mine b)
    (trump-tile b)
    (none (roles e) (mine e) (trump-tile e) (not (tile e a)) (not (tile e b)))))

; -- What a tile can lose, and what a lead calls for. "Outside the viewer's
; hand" is a live tile the viewer does not hold.

; A live tile outside the viewer's hand beats d in context q.
(define loses-in (roles (domino d) (context q))
  (some (roles over) (live over) (not (mine over)) (in over q) (beats over d q)))

; Led, d can lose its suit to a tile outside the viewer's hand.
(define can-lose (roles (domino d))
  (some (roles q) (leads-context d q) (loses-in d q)))

; An off: the viewer's tile, not trump, that can lose.
(define off (roles (domino d))
  (mine d)
  (not (trump-tile d))
  (can-lose d))

; A walker: the viewer's tile, not trump, that cannot lose.
(define walker (roles (domino d))
  (mine d)
  (not (trump-tile d))
  (not (can-lose d)))

; A sure trump: the viewer's trump that no live trump outside his hand beats.
; Holding the top trumps in sequence, any of them.
(define sure-trump (roles (domino d))
  (mine d)
  (trump-tile d)
  (not (can-lose d)))

; Led, d is a low four, five or six: it leads one of those suits and can lose.
(define low-four-five-or-six (roles (domino d))
  (can-lose d)
  (some (roles q) (leads-context d q) (or (context q q4) (context q q5) (context q q6))))

; A live tile beats d in the open trick's context.
(define beatable (roles (domino d))
  (some (roles q over) (led-context q) (live over) (beats over d q)))

; Led, d calls for count: a live count tile outside the viewer's hand follows
; the suit d leads.
(define calls-for-count (roles (domino d))
  (some (roles q called)
    (leads-context d q)
    (live called)
    (not (mine called))
    (in called q)
    (count-tile called)))

; Led, d calls for a tile of n count.
(define calls-for (roles (domino d) (number n))
  (some (roles q called)
    (leads-context d q)
    (live called)
    (not (mine called))
    (in called q)
    (count called n)))

; -- The trick as the book's rules read it: who is taking it, and whether that
; can change.

; The viewer plays last to the open trick: the leader sits after him.
(define last-to-play (roles)
  (some (roles me l) (viewer me) (leader l) (successor me l)))

; The viewer's partner is taking the open trick so far.
(define partner-winning (roles)
  (some (roles me w) (viewer me) (partner me w) (current-winner w)))

; No setter can hold a trump: none is outside the viewer's hand, or every
; setter who might hold one has shown void in trump. Under no trump, always.
(define no-setter-trump (roles)
  (none (roles s t) (setter s) (not (shown-out-of-trump s)) (live t) (not (mine t)) (trump-tile t)))

; The tile taking the open trick cannot be beaten by a setter still to play,
; as far as the viewer can tell: no live tile outside his hand that follows the
; suit led and beats it can be with a setter who has not played to the trick
; and has not shown void in that suit; and trump was led, or no setter still
; to play can hold a trump (a setter who has played to the trick can no longer
; take it: the book's guaranteed trick, S-0057-c). Read from the bidder's side.
(define winner-cannot-be-beaten (roles)
  (some (roles w win q)
    (current-winner w)
    (trick-play w win)
    (led-context q)
    (none (roles s x)
      (setter s)
      (none (roles y) (trick-play s y))
      (not (shown-void s q))
      (live x)
      (not (mine x))
      (in x q)
      (beats x win q))
    (or
      (trump q)
      (none (roles s t)
        (setter s)
        (none (roles y) (trick-play s y))
        (not (shown-out-of-trump s))
        (live t)
        (not (mine t))
        (trump-tile t)))))

; A safe trick, the one to give count to: the viewer's partner is taking it,
; and the viewer plays last or the winning tile cannot be beaten.
(define safe-trick (roles)
  (partner-winning)
  (or (last-to-play) (winner-cannot-be-beaten)))

; The viewer can take the open trick: a tile he may play beats the tile taking
; it, following the suit led or trumping it.
(define can-take-it (roles)
  (some (roles d w win q)
    (own-legal d)
    (current-winner w)
    (trick-play w win)
    (led-context q)
    (beats d win q)))

; The viewer's partner is still to play to the open trick and may hold a tile
; that takes it: a live tile outside the viewer's hand follows the suit led and
; beats the winning tile, and the partner has not shown void in that suit. What
; a setter's pounce needs: a lead that can lose its suit. A ruff is not counted:
; a double or the top tile of its suit, "as good as a double", is no trick to
; pounce on (S-0079-b), and in Hands 30 and 31 the setter throws on the
; partner's double though his own partner might trump it (S-0135-f, S-0139-d).
(define partner-may-take-it (roles)
  (some (roles me pard w win q x)
    (viewer me)
    (partner me pard)
    (none (roles y) (trick-play pard y))
    (current-winner w)
    (trick-play w win)
    (led-context q)
    (live x)
    (not (mine x))
    (in x q)
    (beats x win q)
    (not (shown-void pard q))))

; d is the viewer's double, not trump, and no live tile outside his hand leads
; its suit: it can win only a trick it leads itself. Only a tile whose higher
; end is the suit leads it, so the 0-0 is dead in any hand but its holder's.
(define dead-double (roles (domino d))
  (mine d)
  (double d)
  (not (trump-tile d))
  (some (roles q) (leads-context d q) (none (roles x) (live x) (not (mine x)) (leads-context x q))))

; Suit t has more tiles out than suit s: tiles neither played nor the
; viewer's, following each (an aggregate; the crisis's "most tiles out").
(define more-out (roles (context t) (context s))
  (<
    (card (roles x) (live x) (not (mine x)) (in x s))
    (card (roles x) (live x) (not (mine x)) (in x t))))

; The viewer's tile g, not count, is the last spare of a count tile of his in
; one of g's suits: without g the count tile stands alone there, where a
; double led pulls it. A double needs no guard.
(define guards-count (roles (domino g))
  (mine g)
  (count g 0)
  (some (roles s c)
    (not (trump s))
    (in g s)
    (mine c)
    (count-tile c)
    (not (double c))
    (in c s)
    (none (roles o) (mine o) (in o s) (not (tile o g)) (not (tile o c)))))

; -- The bidder's offs and the doubles ahead of them.

; Led, the viewer's double dd may draw a count tile the off o calls for: a live
; tile outside his hand that follows both dd's suit and the suit o leads.
(define draws-the-count-for (roles (domino dd) (domino o))
  (some (roles s q x)
    (leads-context dd s)
    (leads-context o q)
    (live x)
    (not (mine x))
    (in x s)
    (in x q)
    (count-tile x)))

; The viewer's double dd leads the suit the off o leads: it strips that suit.
(define strips-the-suit-of (roles (domino dd) (domino o))
  (some (roles q) (leads-context dd q) (leads-context o q)))

; The off o is protected by the viewer's double dd: dd is the double of o's
; suit, or dd may draw the count o calls for.
(define protects (roles (domino dd) (domino o))
  (mine dd)
  (double dd)
  (not (trump-tile dd))
  (off o)
  (or (draws-the-count-for dd o) (strips-the-suit-of dd o)))

; The viewer's tile g stands for the double of the off o's suit: not trump, it
; leads o's suit and cannot lose there. The double itself, or the top tile left
; in the suit (p. 77, S-0105-d, Hand 23: under doubles trump the book saves the
; 6-5 for next-to-last, treating it as the 6-1 off's double).
(define stands-for-the-double (roles (domino g) (domino o))
  (mine g)
  (not (trump-tile g))
  (strips-the-suit-of g o)
  (not (can-lose g)))

; An off of the viewer's with nothing standing for its own suit's double.
(define bare-off (roles (domino o))
  (off o)
  (none (roles g) (stands-for-the-double g o)))

; -- The bid.

; The bid needs every trick: a bid of marks (42 a mark, 84 for two).
(define every-trick (roles)
  (<= 42 (bid)))

; Led, d sets the bid if the count it calls for falls on its trick: its own
; count, one called count tile and the trick's point reach what the setters
; still need, which is not zero (already set).
(define lead-sets (roles (domino d))
  (some (roles q called)
    (leads-context d q)
    (live called)
    (not (mine called))
    (in called q)
    (count-tile called)
    (<= 1 (to-set) (+ (count d) (count called) 1))))

; -- The bidder's trouble: trump he cannot draw.

; A live trump outside the bidder's hand that a setter may hold, and no trump
; of his beats it.
(define trump-he-cannot-draw (roles)
  (some (roles s x t)
    (trump t)
    (setter s)
    (not (shown-out-of-trump s))
    (live x)
    (not (mine x))
    (in x t)
    (none (roles a) (mine a) (in a t) (beats a x t))))

; The partner has shown out of trump and two trumps are out, so the setters
; hold both; the bidder holds no two trumps that beat the higher, so if one
; setter holds both, one outlives his draws.
; GAP likelihood: the book places both with one setter by reading the other's
; count play to the first trump trick (Hand 31, p. 106).
(define trumps-he-cannot-draw (roles)
  (some (roles p x y t)
    (trump t)
    (bidders-partner p)
    (shown-out-of-trump p)
    (live x)
    (not (mine x))
    (in x t)
    (live y)
    (not (mine y))
    (in y t)
    (beats x y t)
    (none (roles a b) (mine a) (in a t) (beats a x t) (mine b) (in b t) (beats b x t))))

; The bidder's crisis: a setter holds trump he cannot draw. The book's crisis
; is one that has turned out (S-0073-d; Hands 26 and 31): the trump is shown to
; be a setter's, which the bidder can know when his partner has shown out of
; trump. A trump out that his partner may hold is no crisis; nor is the first
; lead, before anyone has shown anything.
(define crisis (roles)
  (some (roles p) (bidders-partner p) (shown-out-of-trump p))
  (or (trump-he-cannot-draw) (trumps-he-cannot-draw)))

; -- Defending the last trick: an 84, or no trump (Ch. 8; p. 82). The bidder
; saves his one off for the last trick and leads it, so a tile can be that off
; only if it leads its suit: its higher end, unless it is trump.

; x is on the watch list of the viewer's double dd: a live tile outside his
; hand that leads dd's suit, so dd would take it on the last trick. A double
; with an empty list is dead (dead-double).
(define watched-by (roles (domino dd) (domino x))
  (mine dd)
  (double dd)
  (not (trump-tile dd))
  (live x)
  (not (mine x))
  (some (roles q) (leads-context dd q) (leads-context x q)))

; x is a target of the viewer's pair in suit q: x leads q and could be the
; bidder's off, the double of q not being the viewer's; he holds two tiles
; following q, one of which beats x. If the bidder leads the double first, he
; plays the lower on it and takes the off with the higher.
(define pair-target (roles (domino x) (context q))
  (live x)
  (not (mine x))
  (not (double x))
  (leads-context x q)
  (not (trump q))
  (none (roles dd) (double dd) (leads-context dd q) (mine dd))
  (some (roles high low)
    (mine high)
    (mine low)
    (in high q)
    (in low q)
    (not (trump-tile high))
    (not (trump-tile low))
    (beats high x q)))

; Without t the viewer's pair in one of t's suits no longer takes one of its
; targets: t is one of the two tiles that pair needs.
(define keeps-a-pair (roles (domino t))
  (some (roles x q)
    (pair-target x q)
    (in t q)
    (none (roles high low)
      (mine high)
      (mine low)
      (not (tile high t))
      (not (tile low t))
      (in high q)
      (in low q)
      (not (trump-tile high))
      (not (trump-tile low))
      (beats high x q))))

; t guards a tile p that the viewer's pair needs against the double of p's
; other suit: that double is live outside his hand, and t is his only other
; tile of that suit, so a lead of the double would force p but for t.
(define protects-a-pair (roles (domino t))
  (some (roles p r dd)
    (mine p)
    (not (tile p t))
    (not (double p))
    (keeps-a-pair p)
    (in p r)
    (not (trump r))
    (none (roles x q) (pair-target x q) (in p q) (context r q))
    (in t r)
    (double dd)
    (in dd r)
    (live dd)
    (not (mine dd))
    (none (roles o) (mine o) (in o r) (not (tile o p)) (not (tile o t)))))

; t can win nothing on the last trick: not trump, not a double with a live
; watch list, and no pair needs it; at no trump not count either, which the
; setters still need there (p. 82).
(define wins-nothing (roles (domino t))
  (not (trump-tile t))
  (or (every-trick) (count t 0))
  (none (roles x) (watched-by t x))
  (not (keeps-a-pair t)))
