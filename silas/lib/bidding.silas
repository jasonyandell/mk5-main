; The auction's vocabulary (Roberson, Winning 42, Ch. 2 and 7) as named
; relations over a seat's own hand before the declaration: a candidate trump
; suit, its offs, the count they expose, and the book's count of what is at
; risk. A bid policy brings it in with (include bidding); it brings in the
; book's vocabulary too, of which the auction reads the tiles' own facts
; (count-tile).
;
; A suit here is a pip suit, named by a context q0..q6: before the
; declaration no suit is called, so (bears d t) and (high-pip d t) read the
; tile's pips, never a declaration. Sizes and sums are aggregates (README,
; Aggregates): (card (roles d) ...) is how many of the viewer's tiles fit,
; (points (roles c) ...) the count they carry, each over his own hand and the
; tiles' faces, so always decided. A bound is a literal, passed to a
; definition's (number n) parameter. A definition whose body is one number is
; that number, read wherever a number is: (risk t) is the points at risk.

(include book)

; -- Suits.

; t is a pip suit (not the called suit q*).
(define pip-suit (roles (context t))
  (not (context t q*)))

; d is one of the viewer's tiles of suit t.
(define of-suit (roles (domino d) (context t))
  (mine d)
  (bears d t))

; The viewer holds at least n tiles of suit t.
(define suit-at-least (roles (context t) (number n))
  (<= n (card (roles d) (of-suit d t))))

; The viewer holds the double of suit t.
(define suit-double (roles (context t))
  (some (roles d) (of-suit d t) (double d)))

; d is one of the n highest tiles of suit t: fewer than n tiles of the suit
; rank above it. The order is the suit's faces (ranks-above: the double, then
; the other pip down), which is how every declaration that does not make t
; trump ranks the suit's tiles, so it is the suit's order before one is named.
(define top-of-suit (roles (domino d) (context t) (number n))
  (bears d t)
  (< (card (roles e) (ranks-above e d t)) n))

; The viewer holds the n highest tiles of suit t: for two, its double and the
; next (the 6-5 in sixes, the six of any other suit).
(define holds-top (roles (context t) (number n))
  (<= n (card (roles d) (mine d) (top-of-suit d t n))))

; Suit u is longer in the viewer's hand than suit t.
(define longer-suit (roles (context u) (context t))
  (< (card (roles d) (of-suit d t)) (card (roles d) (of-suit d u))))

; Suit u outranks suit t as a trump of equal risk: it is longer, or as long
; with its double where t lacks one.
(define outranks (roles (context u) (context t))
  (or (longer-suit u t) (and (not (longer-suit t u)) (suit-double u) (not (suit-double t)))))

; -- Offs.

; o is an off under trump t: the viewer's, not a trump, not a double.
(define off-under (roles (domino o) (context t))
  (mine o)
  (not (bears o t))
  (not (double o)))

; Under trump t the viewer holds at most n offs.
(define offs-at-most (roles (context t) (number n))
  (<= (card (roles o) (off-under o t)) n))

; -- The count an off exposes (the arena's risk budget, arena/hand_metrics.py).

; Count tile c is exposed under trump t: the viewer lacks it, it is not a
; trump, and it shares a pip with one of his offs.
(define exposed (roles (domino c) (context t))
  (count-tile c)
  (not (mine c))
  (not (bears c t))
  (some (roles o p) (off-under o t) (bears o p) (bears c p)))

; The count exposed under trump t is at most n points.
(define exposes-at-most (roles (context t) (number n))
  (<= (points (roles c) (exposed c t)) n))

; Suit u is a better trump than suit t for the arena: less count exposed, or
; as little and it outranks t.
(define less-exposed (roles (context u) (context t))
  (or
    (< (points (roles c) (exposed c u)) (points (roles c) (exposed c t)))
    (and (<= (points (roles c) (exposed c u)) (points (roles c) (exposed c t))) (outranks u t))))

; -- The book's count of what is at risk (our reading; docs/cross-game.md,
; slice 2). Each off risks its trick and the count of the suit it leads (its
; high pip) that the viewer lacks and is not trump, each count tile counted
; once; without the trump double, one trump trick is at risk too, with the
; count trumps the viewer lacks.

; Count tile c is at risk under trump t.
(define risk-tile (roles (domino c) (context t))
  (count-tile c)
  (not (mine c))
  (or
    (and (bears c t) (not (suit-double t)))
    (and (not (bears c t)) (some (roles o p) (off-under o t) (high-pip o p) (bears c p)))))

; The points at risk under trump t, a number: the count at risk, a trick for
; each off, and a trick without the trump double.
(define risk (roles (context t))
  (+
    (points (roles c) (risk-tile c t))
    (card (roles o) (off-under o t))
    (card (roles) (not (suit-double t)))))

; The points at risk under trump t are at most n.
(define risk-at-most (roles (context t) (number n))
  (<= (risk t) n))

; -- The book's 84 (S-0083-a): three or four trumps, the trump double among
; them, two or three doubles besides, and at most one off, under its own
; double. Every 84 the book bids holds the trump double; the shape as the
; book states it does not say so, and without it four low trumps with two
; doubles (Hand 10, a pass) would be an 84.

(define eighty-four-shape (roles (context t))
  (suit-at-least t 3)
  (not (suit-at-least t 5))
  (suit-double t)
  (<= 2 (card (roles a) (mine a) (double a) (not (bears a t))))
  (<= (card (roles a) (mine a) (double a) (not (bears a t))) 3)
  (offs-at-most t 1)
  (none (roles o p) (off-under o t) (high-pip o p) (none (roles d) (mine d) (double d) (bears d p))))
