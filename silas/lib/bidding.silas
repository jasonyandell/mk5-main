; The auction's vocabulary (Roberson, Winning 42, Ch. 2 and 7) as named
; relations over a seat's own hand before the declaration: a candidate trump
; suit, its offs, the count they expose, and the book's count of what is at
; risk. A bid policy brings it in with (include bidding); it brings in the
; book's vocabulary too, of which the auction reads the tiles' own facts
; (count-tile).
;
; A suit here is a pip suit, named by a context q0..q6: before the
; declaration no suit is called, so (bears d t) and (high-pip d t) read the
; tile's pips, never a declaration. Numbers are literal-only and Silas has no
; aggregate yet (GAPS.md, 5), so "at most n points" is written as "no set of
; tiles worth more than n": the count tiles are worth 10 (5-5, 6-4) or 5
; (5-0, 4-1, 3-2), so a handful of such sets says each bound exactly.

(include book)

; -- Suits.

; t is a pip suit (not the called suit q*).
(define pip-suit (roles (context t))
  (not (context t q*)))

; d is one of the viewer's tiles of suit t.
(define of-suit (roles (domino d) (context t))
  (mine d)
  (bears d t))

; The viewer holds at least one, two, ... seven tiles of suit t.
(define suit-at-least-1 (roles (context t))
  (some (roles a) (of-suit a t)))

(define suit-at-least-2 (roles (context t))
  (some (roles a b) (of-suit a t) (of-suit b t)))

(define suit-at-least-3 (roles (context t))
  (some (roles a b c) (of-suit a t) (of-suit b t) (of-suit c t)))

(define suit-at-least-4 (roles (context t))
  (some (roles a b c d) (of-suit a t) (of-suit b t) (of-suit c t) (of-suit d t)))

(define suit-at-least-5 (roles (context t))
  (some (roles a b c d e) (of-suit a t) (of-suit b t) (of-suit c t) (of-suit d t) (of-suit e t)))

(define suit-at-least-6 (roles (context t))
  (some (roles a b c d e f)
    (of-suit a t)
    (of-suit b t)
    (of-suit c t)
    (of-suit d t)
    (of-suit e t)
    (of-suit f t)))

(define suit-at-least-7 (roles (context t))
  (some (roles a b c d e f g)
    (of-suit a t)
    (of-suit b t)
    (of-suit c t)
    (of-suit d t)
    (of-suit e t)
    (of-suit f t)
    (of-suit g t)))

; The viewer holds the double of suit t.
(define suit-double (roles (context t))
  (some (roles d) (of-suit d t) (double d)))

; Suit u is longer in the viewer's hand than suit t.
(define longer-suit (roles (context u) (context t))
  (or
    (and (suit-at-least-1 u) (not (suit-at-least-1 t)))
    (and (suit-at-least-2 u) (not (suit-at-least-2 t)))
    (and (suit-at-least-3 u) (not (suit-at-least-3 t)))
    (and (suit-at-least-4 u) (not (suit-at-least-4 t)))
    (and (suit-at-least-5 u) (not (suit-at-least-5 t)))
    (and (suit-at-least-6 u) (not (suit-at-least-6 t)))
    (and (suit-at-least-7 u) (not (suit-at-least-7 t)))))

; Suit u outranks suit t as a trump of equal risk: it is longer, or as long
; with its double where t lacks one.
(define outranks (roles (context u) (context t))
  (or (longer-suit u t) (and (not (longer-suit t u)) (suit-double u) (not (suit-double t)))))

; -- Offs.

; o is an off under trump t: the viewer's, not a trump, not a double.
(define off-under (roles (domino o) (context t))
  (mine o)
  (not (bears o t))
  (not (double o)))

; Under trump t the viewer holds at most none, one, two or three offs.
(define offs-at-most-0 (roles (context t))
  (none (roles o) (off-under o t)))

(define offs-at-most-1 (roles (context t))
  (none (roles o p) (off-under o t) (off-under p t)))

(define offs-at-most-2 (roles (context t))
  (none (roles o p q) (off-under o t) (off-under p t) (off-under q t)))

(define offs-at-most-3 (roles (context t))
  (none (roles o p q r) (off-under o t) (off-under p t) (off-under q t) (off-under r t)))

; -- The count an off exposes (the arena's risk budget, arena/hand_metrics.py).

; Count tile c is exposed under trump t: the viewer lacks it, it is not a
; trump, and it shares a pip with one of his offs.
(define exposed (roles (domino c) (context t))
  (count-tile c)
  (not (mine c))
  (not (bears c t))
  (some (roles o p) (off-under o t) (bears o p) (bears c p)))

; The count exposed under trump t is at most 0, 5, ..., 30 points.
(define exposes-at-most-0 (roles (context t))
  (none (roles c) (exposed c t)))

(define exposes-at-most-5 (roles (context t))
  (none (roles c) (exposed c t) (count c 10))
  (none (roles a b) (exposed a t) (exposed b t)))

(define exposes-at-most-10 (roles (context t))
  (none (roles a b) (exposed a t) (count a 10) (exposed b t))
  (none (roles a b c) (exposed a t) (exposed b t) (exposed c t)))

(define exposes-at-most-15 (roles (context t))
  (none (roles a b) (exposed a t) (count a 10) (exposed b t) (count b 10))
  (none (roles a b c) (exposed a t) (count a 10) (exposed b t) (exposed c t))
  (none (roles a b c d) (exposed a t) (exposed b t) (exposed c t) (exposed d t)))

(define exposes-at-most-20 (roles (context t))
  (none (roles a b c) (exposed a t) (count a 10) (exposed b t) (count b 10) (exposed c t))
  (none (roles a b c d) (exposed a t) (exposed b t) (exposed c t) (exposed d t)))

(define exposes-at-most-25 (roles (context t))
  (none (roles a b c d)
    (exposed a t)
    (count a 10)
    (exposed b t)
    (count b 10)
    (exposed c t)
    (exposed d t)))

(define exposes-at-most-30 (roles (context t))
  (none (roles a b c d e) (exposed a t) (exposed b t) (exposed c t) (exposed d t) (exposed e t)))

; -- The book's count of what is at risk (our reading; docs/cross-game.md,
; slice 2). Each off risks its trick and the count of the suit it leads (its
; high pip) that the viewer lacks and is not trump, each count tile counted
; once; without the trump double, one trump trick is at risk too, with the
; count trumps the viewer lacks.

; Count tile c is at risk under trump t.
(define risk-tile (roles (domino c) (context t))
  (count-tile c)
  (not (mine c))
  (or
    (and (bears c t) (not (suit-double t)))
    (and (not (bears c t)) (some (roles o p) (off-under o t) (high-pip o p) (bears c p)))))

; The count at risk under trump t is at most 0, 5, 10 or 15 points.
(define risk-points-at-most-0 (roles (context t))
  (none (roles c) (risk-tile c t)))

(define risk-points-at-most-5 (roles (context t))
  (none (roles c) (risk-tile c t) (count c 10))
  (none (roles a b) (risk-tile a t) (risk-tile b t)))

(define risk-points-at-most-10 (roles (context t))
  (none (roles a b) (risk-tile a t) (count a 10) (risk-tile b t))
  (none (roles a b c) (risk-tile a t) (risk-tile b t) (risk-tile c t)))

(define risk-points-at-most-15 (roles (context t))
  (none (roles a b) (risk-tile a t) (count a 10) (risk-tile b t) (count b 10))
  (none (roles a b c) (risk-tile a t) (count a 10) (risk-tile b t) (risk-tile c t))
  (none (roles a b c d) (risk-tile a t) (risk-tile b t) (risk-tile c t) (risk-tile d t)))

; The tricks at risk under trump t (one per off, and one without the trump
; double) are at most 0 to 4. With three trumps or more there are at most
; four offs, so five is never exceeded.
(define risk-tricks-at-most-0 (roles (context t))
  (suit-double t)
  (offs-at-most-0 t))

(define risk-tricks-at-most-1 (roles (context t))
  (or (and (suit-double t) (offs-at-most-1 t)) (offs-at-most-0 t)))

(define risk-tricks-at-most-2 (roles (context t))
  (or (and (suit-double t) (offs-at-most-2 t)) (offs-at-most-1 t)))

(define risk-tricks-at-most-3 (roles (context t))
  (or (and (suit-double t) (offs-at-most-3 t)) (offs-at-most-2 t)))

(define risk-tricks-at-most-4 (roles (context t))
  (or (suit-double t) (offs-at-most-3 t)))

; The points at risk under trump t (count and tricks) are at most 0 to 12,
; or 17: a split of the bound between count, in fives, and tricks.
(define risk-at-most-0 (roles (context t))
  (risk-points-at-most-0 t)
  (risk-tricks-at-most-0 t))

(define risk-at-most-1 (roles (context t))
  (risk-points-at-most-0 t)
  (risk-tricks-at-most-1 t))

(define risk-at-most-2 (roles (context t))
  (risk-points-at-most-0 t)
  (risk-tricks-at-most-2 t))

(define risk-at-most-3 (roles (context t))
  (risk-points-at-most-0 t)
  (risk-tricks-at-most-3 t))

(define risk-at-most-4 (roles (context t))
  (risk-points-at-most-0 t)
  (risk-tricks-at-most-4 t))

(define risk-at-most-5 (roles (context t))
  (or (risk-points-at-most-0 t) (and (risk-points-at-most-5 t) (risk-tricks-at-most-0 t))))

(define risk-at-most-6 (roles (context t))
  (or (risk-points-at-most-0 t) (and (risk-points-at-most-5 t) (risk-tricks-at-most-1 t))))

(define risk-at-most-7 (roles (context t))
  (or (risk-points-at-most-0 t) (and (risk-points-at-most-5 t) (risk-tricks-at-most-2 t))))

(define risk-at-most-8 (roles (context t))
  (or (risk-points-at-most-0 t) (and (risk-points-at-most-5 t) (risk-tricks-at-most-3 t))))

(define risk-at-most-9 (roles (context t))
  (or (risk-points-at-most-0 t) (and (risk-points-at-most-5 t) (risk-tricks-at-most-4 t))))

(define risk-at-most-10 (roles (context t))
  (or (risk-points-at-most-5 t) (and (risk-points-at-most-10 t) (risk-tricks-at-most-0 t))))

(define risk-at-most-11 (roles (context t))
  (or (risk-points-at-most-5 t) (and (risk-points-at-most-10 t) (risk-tricks-at-most-1 t))))

(define risk-at-most-12 (roles (context t))
  (or (risk-points-at-most-5 t) (and (risk-points-at-most-10 t) (risk-tricks-at-most-2 t))))

(define risk-at-most-17 (roles (context t))
  (or (risk-points-at-most-10 t) (and (risk-points-at-most-15 t) (risk-tricks-at-most-2 t))))

; -- The book's 84 (S-0083-a): three or four trumps, the trump double among
; them, two or three doubles besides, and at most one off, under its own
; double. Every 84 the book bids holds the trump double; the shape as the
; book states it does not say so, and without it four low trumps with two
; doubles (Hand 10, a pass) would be an 84.

(define eighty-four-shape (roles (context t))
  (suit-at-least-3 t)
  (not (suit-at-least-5 t))
  (suit-double t)
  (some (roles a b) (mine a) (double a) (not (bears a t)) (mine b) (double b) (not (bears b t)))
  (none (roles a b c d)
    (mine a)
    (double a)
    (not (bears a t))
    (mine b)
    (double b)
    (not (bears b t))
    (mine c)
    (double c)
    (not (bears c t))
    (mine d)
    (double d)
    (not (bears d t)))
  (offs-at-most-1 t)
  (none (roles o p) (off-under o t) (high-pip o p) (none (roles d) (mine d) (double d) (bears d p))))
